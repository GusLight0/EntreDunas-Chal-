# Copie este arquivo para ".env" (não versionado) para testar localmente com
# `vercel dev` (ou `netlify dev`, se ainda estiver usando o Netlify), ou
# cadastre estes mesmos nomes em:
# Vercel -> Project Settings -> Environment Variables
# Netlify -> Site configuration -> Environment variables

# Painel do Asaas > Integrações > API Key (sandbox para teste, produção depois)
ASAAS_API_URL=https://api-sandbox.asaas.com/v3
ASAAS_API_KEY=

# Painel do Asaas > Integrações > Webhooks > token cadastrado no cabeçalho
# "Asaas-Access-Token" — invente uma string aleatória e cole a mesma nos dois lados.
ASAAS_WEBHOOK_TOKEN=

# Painel do desenvolvedor do Mercado Pago > Credenciais de teste (depois de produção)
# Só necessário se voltar a usar o fluxo legado em api/create-payment.js.
MP_ACCESS_TOKEN=

# Firebase Console > Configurações do projeto > Contas de serviço >
# "Gerar nova chave privada" baixa um .json — cole o CONTEÚDO inteiro
# desse arquivo aqui, em uma linha só.
FIREBASE_SERVICE_ACCOUNT=
